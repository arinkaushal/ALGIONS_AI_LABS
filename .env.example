# ==============================================================================
# Cinema Hall Ticket Booking Service - Environment Configuration Template
# Copy this file to .env and configure your secrets locally. DO NOT commit .env!
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_VERSION=1.0.0
LOG_LEVEL=info

# Database Connection
# For local SQLite development:
# DATABASE_URL=sqlite:./data/cinema.db
# For PostgreSQL container deployment:
DATABASE_URL=postgresql://cinema_user:cinema_secure_password_2026@postgres-db:5432/cinema_db

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_secure_password_2026
POSTGRES_DB=cinema_db

# Database Connection Pool Settings
DB_MAX_CONNECTIONS=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Seat Hold Business Rules
HOLD_DURATION_SECONDS=300
HOLD_CLEANUP_INTERVAL_MS=30000

# Security and Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
